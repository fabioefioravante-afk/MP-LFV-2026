Cell[BoxData[{
 RowBox[{
  RowBox[{"BLRUnitaryGauge", "=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"LoopRefineSeries", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
         "ampCGBSameChirLL1", "\[LeftDoubleBracket]", "1", 
          "\[RightDoubleBracket]"}], ",", 
         RowBox[{
         "ampCGBSameChirLL1", "\[LeftDoubleBracket]", "2", 
          "\[RightDoubleBracket]"}]}], "}"}], ",", 
