     "\!\(\*StyleBox[FormBox[RowBox[{RowBox[{\"{\", \
RowBox[{RowBox[{SubscriptBox[\"B\", \"L\"], \"(\", \"0\", \")\"}], \",\", \
RowBox[{SubscriptBox[\"B\", \"R\"], \"(\", \"0\", \")\"}]}], \"}\"}], \"  \
\"}],TraditionalForm],FontWeight->\"Plain\"]\)\!\(\*StyleBox[\"=\",FontWeight-\
>\"Plain\"]\)  ", 
      RGBColor[0, 0, 1], 24]]], "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{"128", " ", 
        SuperscriptBox["me", "3"], " ", 
        SuperscriptBox["mW1", "2"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"me", "-", "m\[Mu]"}], ")"}], "2"], " ", 
        SuperscriptBox["m\[Mu]", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"me", "+", "m\[Mu]"}], ")"}], " ", 
        SuperscriptBox["\[Pi]", "2"]}]], 
      RowBox[{"e", " ", 
       SuperscriptBox["g", "2"], " ", "Uej", " ", 
       RowBox[{"Conjugate", "[", "U\[Mu]j", "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
