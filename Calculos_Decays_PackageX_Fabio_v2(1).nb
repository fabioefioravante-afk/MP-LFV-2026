Cell[TextData[{
 "So we can write the amplitude for SM contribution and use the Package - X  \
Projectors to obtain the desired Form Factors. Note that {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", 
    RowBox[{"R", " "}]], TraditionalForm]],ExpressionUUID->
  "1b70690f-92ac-4689-bb5a-afe4a1877d45"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", 
    RowBox[{"L", " "}]], TraditionalForm]],ExpressionUUID->
  "d0f6be91-2362-4690-977f-4c3decb313c2"],
 "}  we identify as, in my calculation with {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", 
    RowBox[{"R", " "}]], TraditionalForm]],ExpressionUUID->
  "e50d02ed-f051-4a2b-a2e5-b618c8358cfe"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["A", "L"], "}"}], "*", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["m", "e"], "+", 
      SubscriptBox["m", "\[Mu]"]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "0696628b-c235-4b17-b27a-da6f663cdf7b"]
}], "Text",
 CellChangeTimes->{{3.842535233697335*^9, 3.842535277788373*^9}, 
   3.85505789987847*^9, {3.986471126878642*^9, 3.9864711270229273`*^9}, {
   3.9864711704691973`*^9, 3.986471185702058*^9}, {3.9867607348664207`*^9, 
   3.9867607470142612`*^9}, {3.98676078080492*^9, 3.986760926003791*^9}, {
   3.9867971172697487`*^9, 3.986797130319121*^9}},
 Background->RGBColor[
  0.94, 0.88, 0.94],ExpressionUUID->"7f3b5e12-bf89-48e9-b562-cc7ca0e4f123"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"onshell", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"p1", ".", "p1"}], " ", "\[Rule]", " ", 
       SuperscriptBox["m\[Mu]", "2"]}], " ", ",", " ", 
      RowBox[{
       RowBox[{"p2", ".", "p2"}], " ", "\[Rule]", " ", 
       SuperscriptBox["me", "2"]}], ",", " ", 
      RowBox[{
       RowBox[{"p1", ".", "p2"}], " ", "\[Rule]", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"q", ".", "q"}]}], "/", "2"}], "  ", "+", " ", 
        RowBox[{
         SuperscriptBox["m\[Mu]", "2"], "/", "2"}], "+", " ", 
        RowBox[{
         SuperscriptBox["me", "2"], "/", "2"}]}]}]}], " ", "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"It", " ", "is", " ", "necessary", " ", "to", " ", "include", " ", 
     RowBox[{"(", 
      FractionBox["i", 
       RowBox[{"16", 
        SuperscriptBox["\[Pi]", "2"]}]], ")"}], " ", "when", " ", "doing", " ",
      "an", " ", "integration", " ", "on", " ", "Package"}], "-", 
    RowBox[{"X", "."}]}], " ", "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ampCGBSameChirLL1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "\[ImaginaryI]"}], ")"}], 
      RowBox[{"(", 
       FractionBox["\[ImaginaryI]", 
        RowBox[{"16", " ", 
         SuperscriptBox["\[Pi]", "2"]}]], ")"}], " ", 
      SuperscriptBox["U\[Mu]j", "\[Conjugate]"], " ", "Uej", " ", 
      RowBox[{"LoopIntegrate", "[", 
       RowBox[{
        RowBox[{"Contract", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["\[DoubleStruckG]", 
               RowBox[{"\[Alpha]", ",", "\[Lambda]"}]], " ", "-", " ", 
              FractionBox[
               RowBox[{
                SubscriptBox[
                 RowBox[{"(", 
                  RowBox[{"p1", "-", "k"}], ")"}], "\[Alpha]"], "  ", 
                SubscriptBox[
                 RowBox[{"(", 
                  RowBox[{"p1", " ", "-", " ", "k"}], ")"}], "\[Lambda]"]}], 
               SuperscriptBox["mW1", "2"]]}], ")"}]}], " ", ")"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "e", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               SubscriptBox["\[DoubleStruckG]", 
                RowBox[{"\[Mu]", ",", "\[Nu]"}]], 
               SubscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "p1"}], "+", 
                  RowBox[{"2", "p2"}], "-", "k"}], ")"}], "\[Lambda]"]}], "+", 
              RowBox[{
               SubscriptBox["\[DoubleStruckG]", 
                RowBox[{"\[Lambda]", ",", "\[Mu]"}]], 
               SubscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"2", "p1"}], "-", "p2", "-", "k"}], ")"}], 
                "\[Nu]"]}], "+", 
              RowBox[{
               SubscriptBox["\[DoubleStruckG]", 
                RowBox[{"\[Nu]", ",", "\[Lambda]"}]], 
               SubscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "p1"}], "-", "p2", "+", 
                  RowBox[{"2", "k"}]}], ")"}], "\[Mu]"]}]}], " ", ")"}]}], 
           ")"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["\[DoubleStruckG]", 
               RowBox[{"\[Nu]", ",", "\[Beta]"}]], " ", "-", " ", 
              FractionBox[
               RowBox[{
                SubscriptBox[
                 RowBox[{"(", 
                  RowBox[{"p2", "-", "k"}], ")"}], "\[Nu]"], "  ", 
                SubscriptBox[
                 RowBox[{"(", 
                  RowBox[{"p2", " ", "-", " ", "k"}], ")"}], "\[Beta]"]}], 
               SuperscriptBox["mW1", "2"]]}], ")"}]}], " ", ")"}], 
          RowBox[{"Spur", "[", 
           RowBox[{
            RowBox[{"\[ImaginaryI]", 
             RowBox[{"(", 
              FractionBox["g", 
               RowBox[{"2", 
                SqrtBox["2"]}]], ")"}], 
             SubscriptBox["\[Gamma]", "\[Beta]"]}], ",", 
            RowBox[{"(", 
             RowBox[{"\[DoubleStruckOne]", "-", "\[Gamma]5"}], ")"}], ",", 
            RowBox[{"\[ImaginaryI]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[Gamma]", ".", "k"}], " ", "+", " ", 
               RowBox[{"mj", " ", "\[DoubleStruckOne]"}]}], ")"}]}], ",", 
            RowBox[{"\[ImaginaryI]", 
             RowBox[{"(", 
              FractionBox["g", 
               RowBox[{"2", 
                SqrtBox["2"]}]], ")"}], 
             SubscriptBox["\[Gamma]", "\[Alpha]"]}], ",", 
            RowBox[{"(", 
             RowBox[{"\[DoubleStruckOne]", "-", "\[Gamma]5"}], ")"}], ",", 
            RowBox[{
             RowBox[{"Projector", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<BL\>\"", ",", "\"\<BR\>\""}], "}"}], ",", 
               "\[Mu]"}], "]"}], "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"p1", ",", "m\[Mu]"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"p2", ",", "me"}], "}"}]}], "]"}]}], "]"}]}], "]"}], ",",
         "k", ",", 
        RowBox[{"{", 
         RowBox[{"k", " ", ",", "mj"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p1", " ", "-", " ", "k"}], ",", " ", "mW1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p2", " ", "-", " ", "k"}], " ", ",", " ", "mW1"}], "}"}]}],
        "]"}]}], "/.", "onshell"}], "//", "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.84253530512524*^9, 3.8425353802635326`*^9}, {
   3.842535411660735*^9, 3.8425356198278837`*^9}, {3.842535832460517*^9, 
   3.842536015549788*^9}, 3.842541810780801*^9, {3.8425429290138855`*^9, 
   3.842542932928834*^9}, {3.842549580948919*^9, 3.8425495894933977`*^9}, 
   3.8425499751331615`*^9, 3.844418928189897*^9, {3.8547010272675457`*^9, 
   3.8547010277725096`*^9}, {3.986470712163745*^9, 3.986470732072628*^9}, {
   3.9864707772851963`*^9, 3.986470786144093*^9}, {3.986471259425798*^9, 
   3.9864712808633223`*^9}, {3.9864713153392963`*^9, 3.986471316063703*^9}},
 Background->RGBColor[0.88, 1, 0.88],
 CellLabel->"In[5]:=",ExpressionUUID->"e9ed4464-59eb-4a1c-9cd6-c7629181528d"],

