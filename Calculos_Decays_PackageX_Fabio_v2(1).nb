Cell[TextData[{
 "So, given an amplitude, we need to compute the form factors ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "2"], "(", "0", ")"}], TraditionalForm]],ExpressionUUID->
  "f0e3cdd4-8901-4e1d-977f-fff0e5d5ab4d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", "2"], "(", "0", ")"}], TraditionalForm]],ExpressionUUID->
  "570dd586-0f32-413e-8edb-7991f8269137"],
 " to evaluate BR (\[Mu] \[Rule] e \[Gamma]), what can be done with Package-X"
}], "Text",
 CellChangeTimes->{{3.842533924902935*^9, 3.842533991119149*^9}},
 Background->RGBColor[
  0.94, 0.88, 0.94],ExpressionUUID->"0aad619c-914c-48b8-871c-599e907323d3"],

